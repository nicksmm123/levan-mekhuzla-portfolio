# Copy this file to .env.local for local development outside Replit.
# On Vercel, set these under Project → Settings → Environment Variables.

# Supabase — find both values in your Supabase project → Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Set automatically by the Vercel build command (BASE_PATH=/).
# Only needed locally if running `pnpm build` directly.
# BASE_PATH=/
